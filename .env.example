# Server only. Copy to .env.local; never commit your key.
OPENAI_API_KEY=
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_BACKEND_MODEL=gpt-5.6-terra
# Required for Vercel: a random server-only secret for session cleanup.
OPENAI_SESSION_SECRET=
# Optional comma-separated custom domains (no scheme).
APP_ALLOWED_HOSTS=
